---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
---

<Layout title="ShazQIAI">
  <div class="pt-36">
    <Container>
      <!-- ChatBoxStart -->
      <div
        class="relative max-w-2xl mx-auto mt-16 rounded-xl p-6 bg-white dark:bg-gray-900 shadow-lg transition-all duration-300 border border-transparent hover:border-[3px] hover:border-[rgb(0,255,255)] group"
      >
        <!-- Gradient Glow Border -->
        <div
          class="absolute inset-0 animate-gradient-move bg-gradient-to-r from-cyan-400 via-purple-500 to-pink-500 
                bg-[length:200%_200%] bg-[position:0%_50%] blur-lg opacity-80 rounded-xl z-[-1]"
        ></div>

        <!-- Chat Header with Clear Button -->
        <div class="flex justify-between items-center mb-4">
          <h2 class="text-xl font-bold text-gray-900 dark:text-white">ShazQIAI Assistant</h2>
          <button
            id="clear-chat"
            class="text-sm text-gray-500 hover:text-red-500 transition px-2 py-1 rounded"
            aria-label="Clear chat history"
          >
            Clear Chat
          </button>
        </div>

        <!-- Chat Content (Hanya teks non-kode) -->
        <div
          id="chat-messages"
          class="mb-4 space-y-3 max-h-64 overflow-y-auto text-gray-900 dark:text-white text-sm"
        >
          <div class="text-left">🤖 Halo! Ada yang bisa aku bantu? Coba tanya soal koding!</div>
        </div>

        <!-- Input -->
        <form id="chat-form" class="flex flex-col space-y-2 sm:flex-row sm:space-x-2 sm:space-y-0">
          <input
            id="chat-input"
            class="rounded-md p-2 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary w-full"
            placeholder="Tulis pertanyaanmu... (misal: 'buat fungsi JS untuk sort array')"
          />
          <button
            type="submit"
            class="bg-primary text-white px-4 py-2 rounded-md hover:brightness-110 transition w-full sm:w-auto"
          >
            Kirim
          </button>
        </form>
      </div>
      <!-- ChatBoxEnd -->

      <!-- Code Output Panel (Terpisah, muncul kalau ada kode) -->
      <div
        id="code-output"
        class="max-w-2xl mx-auto mt-4 p-4 bg-white dark:bg-gray-900 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 hidden"
        aria-label="Generated code output"
      >
        <div class="flex justify-between items-center mb-2">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Generated Code</h3>
          <button
            id="clear-code"
            class="text-sm text-gray-500 hover:text-red-500 transition px-2 py-1 rounded"
            aria-label="Clear code output"
          >
            Clear Code
          </button>
        </div>
        <div id="code-content" class="space-y-4"></div>
      </div>
    </Container>
  </div>

<script is:inline>
  // Load Highlight.js dynamically
  let hljsLoaded = false;
  function loadHighlightJS() {
    if (hljsLoaded) return;
    const script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/lib/core.min.js';
    script.onload = () => {
      const langScript = document.createElement('script');
      langScript.src = 'https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/lib/languages/javascript.min.js';
      langScript.onload = () => {
        const pythonScript = document.createElement('script');
        pythonScript.src = 'https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/lib/languages/python.min.js';
        document.head.appendChild(pythonScript);
        hljsLoaded = true;
        hljs.highlightAll();
      };
      document.head.appendChild(langScript);
    };
    document.head.appendChild(script);
  }

  const form = document.getElementById("chat-form");
  const input = document.getElementById("chat-input");
  const messages = document.getElementById("chat-messages");
  const clearBtn = document.getElementById("clear-chat");
  const codeOutput = document.getElementById("code-output");
  const codeContent = document.getElementById("code-content");
  const clearCodeBtn = document.getElementById("clear-code");

  const history = [
    { role: "assistant", content: "Halo! Ada yang bisa aku bantu? Coba tanya soal koding!" }
  ];

  // Username otomatis dari localStorage atau prompt
  let username = localStorage.getItem('shazqiai-username') || null;
  if (!username) {
    username = prompt("Siapa nama kamu? (Opsional, buat personalisasi)") || "User ";
    localStorage.setItem('shazqiai-username', username);
  }

  // Fungsi untuk extract dan render code blocks (hanya ke code-output)
  function extractAndRenderCode(content) {
    const codeBlockRegex = /```(\w+)?\n([\s\S]*?)```/g;
    let match;
    const codes = [];
    let cleanText = content; // Text tanpa code blocks

    while ((match = codeBlockRegex.exec(content)) !== null) {
      const lang = match[1] || 'text';
      const code = match[2].trim();
      codes.push({ lang, code });

      // Hapus code block dari text (ganti dengan placeholder atau kosong)
      cleanText = cleanText.replace(match[0], ''); // Atau ganti dengan "Lihat kode di bawah" kalau mau
    }

    // Render codes ke panel (clear dulu)
    codeContent.innerHTML = '';
    if (codes.length > 0) {
      loadHighlightJS();
      codeOutput.classList.remove('hidden'); // Tampilkan panel

      codes.forEach(({ lang, code }, index) => {
        const codeContainer = document.createElement("div");
        codeContainer.className = "code-block relative my-2";

        const pre = document.createElement("pre");
        pre.className = `language-${lang} bg-gray-100 dark:bg-gray-800 p-4 rounded-md overflow-x-auto`;

        const codeElem = document.createElement("code");
        codeElem.className = `language-${lang}`;
        codeElem.textContent = code;

        pre.appendChild(codeElem);

        // Copy button
        const copyBtn = document.createElement("button");
        copyBtn.textContent = "Copy";
        copyBtn.className = "absolute top-2 right-2 bg-blue-500 text-white px-2 py-1 rounded text-xs hover:bg-blue-600 transition z-10";
        copyBtn.setAttribute("aria-label", `Copy ${lang} code`);
        copyBtn.onclick = async () => {
          try {
            await navigator.clipboard.writeText(code);
            copyBtn.textContent = "Copied!";
            copyBtn.classList.add("bg-green-500");
            setTimeout(() => {
              copyBtn.textContent = "Copy";
              copyBtn.classList.remove("bg-green-500");
            }, 2000);
          } catch (err) {
            const textArea = document.createElement("textarea");
            textArea.value = code;
            document.body.appendChild(textArea);
            textArea.select();
            document.execCommand("copy");
            document.body.removeChild(textArea);
            copyBtn.textContent = "Copied!";
            setTimeout(() => { copyBtn.textContent = "Copy"; }, 2000);
          }
        };

        codeContainer.appendChild(copyBtn);
        codeContainer.appendChild(pre);
        codeContent.appendChild(codeContainer);

        // Highlight
        if (hljsLoaded) {
          hljs.highlightElement(codeElem);
        }
      });
    } else {
      codeOutput.classList.add('hidden'); // Sembunyikan kalau no code
    }

    return cleanText.trim() || " (Lihat kode di bawah jika ada)"; // Return text bersih buat chat
  }

  // Fungsi render message ke chat (hanya teks non-kode)
  function renderMessageToChat(prefix, content, roleClass = "text-left") {
    const cleanContent = extractAndRenderCode(content); // Extract code dulu
    const msgDiv = document.createElement("div");
    msgDiv.className = roleClass;
    msgDiv.textContent = prefix + cleanContent;
    return msgDiv;
  }

  // Submit handler
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const text = input.value.trim();
    if (!text) return;

    history.push({ role: "user", content: text });

    const userMsg = renderMessageToChat("🧑 ", text, "text-right text-blue-600");
    messages.appendChild(userMsg);

    input.value = "";
    messages.scrollTop = messages.scrollHeight;

    const botMsgContainer = document.createElement("div");
    botMsgContainer.className = "text-left italic text-gray-500";
    const botTyping = document.createElement("div");
    botTyping.textContent = "🤖 Sedang mengetik...";
    botMsgContainer.appendChild(botTyping);
    messages.appendChild(botMsgContainer);
    messages.scrollTop = messages.scrollHeight;

    try {
      const res = await fetch("https://shazqi-ai-backend-deploy.vercel.app/api/gemini", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ messages: history, username }),
      });

      const data = await res.json();
      let reply = data.reply || "Maaf, tidak ada jawaban.";

      // Ganti loading dengan teks bersih
      botMsgContainer.innerHTML = "";
      const botMsg = renderMessageToChat("🤖 ", reply);
      botMsgContainer.appendChild(botMsg);
      botMsgContainer.classList.remove("italic", "text-gray-500");

      if (hljsLoaded) hljs.highlightAll();

      history.push({ role: "assistant", content: reply });
    } catch (err) {
      botMsgContainer.innerHTML = "";
      const errorMsg = renderMessageToChat("🤖 ", "Maaf, terjadi kesalahan. Coba lagi nanti.");
      errorMsg.classList.add("text-red-500");
      botMsgContainer.appendChild(errorMsg);
      botMsgContainer.classList.remove("italic", "text-gray-500");
    }

    messages.scrollTop = messages.scrollHeight;
  });

  // Clear chat handler (juga clear code)
  clearBtn?.addEventListener("click", () => {
    messages.innerHTML = '<div class="text-left">🤖 Chat dihapus. Mulai baru yuk!</div>';
    history.length = 0;
    history.push({ role: "assistant", content: "Chat dihapus. Mulai baru yuk!" });
    codeOutput.classList.add('hidden'); // Sembunyikan code panel
    codeContent.innerHTML = '';
    input.focus();
  });

  // Clear code handler (opsional, cuma clear code tanpa chat)
  clearCodeBtn?.addEventListener("click", () => {
    codeOutput.classList.add('hidden');
    codeContent.innerHTML = '';
  });
</script>
---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import SearchDokumentasi from "../components/SearchDocumentation.jsx"; // 👈 Pakai komponen interaktif
import MovingbgFortasi from '../components/MovingbgFortasi';
---

<Layout showImage={true} title="UpdatePage">
  <div class="relative pt-36" id="updates">
    <Container>

<section>
    <MovingbgFortasi client:visible videoSrc="/bg/mplsday1.webm" direction="left"/>
    <MovingbgFortasi client:visible videoSrc="/bg/mplsday2.webm " direction="right"/>
    <MovingbgFortasi client:visible videoSrc="/bg/mplsday3.webm" direction="bottom"/>
    <MovingbgFortasi client:visible videoSrc="/bg/mplsday4.webm" direction="left"/>
    <MovingbgFortasi client:visible videoSrc="/bg/mplsday5.webm" direction="right"/>
    <MovingbgFortasi client:visible videoSrc="/bg/mplsday6.webm" direction="bottom"/>
</section>

      <div aria-hidden="true" class="absolute inset-0 h-max w-full m-auto grid grid-cols-2 -space-x-52 opacity-40 dark:opacity-20">
        <div class="blur-[106px] h-56 bg-gradient-to-br from-primary to-purple-400 dark:from-blue-700"></div>
        <div class="blur-[106px] h-32 bg-gradient-to-r from-cyan-400 to-sky-300 dark:to-indigo-600"></div>
      </div>

      <div class="relative">
        <h1 class="text-center text-4xl font-bold text-gray-800 dark:text-white md:text-5xl Anurati-font">UPDATE PAGE</h1>
        <p class="text-center text-xl text-gray-600 dark:text-gray-300 mb-10">
          ✨You can search for your Documents on this page.✨
        </p>

        <!-- ✅ Ganti dengan komponen interaktif -->
        <SearchDokumentasi client:load />
      </div>

    </Container>
  </div>
  <style>
    @font-face {
    font-family: 'AnuratiFont';
    src: url('/src/assets/fonts/Anurati-Regular.otf') format('opentype');
    font-weight: normal;
    font-style: normal;
  }

  .Anurati-font {
    font-family: 'AnuratiFont', sans-serif;
  }
  </style>
</Layout>

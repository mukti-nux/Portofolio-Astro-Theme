---
// BirthdayShq.astro
import { birthdayData } from './../data/birthdayData.ts';
---

<div class="birthday-container">
    <canvas id="balloonCanvas"></canvas>

    <div class="birthday-button">
        <button class="birthday-button__button">
            <!-- removed SVG cake - keep only the button text -->
            <span class="birthday-button__text">Happy Birthday!</span>
        </button>
    </div>

    <!-- Personalized Content Overlay -->
    <div class="content-overlay" style="display: none; opacity: 0;">
        <div class="message-card">
            <h1 class="target-name">{birthdayData.name}</h1>
            <p class="birthday-message">{birthdayData.message}</p>
            {birthdayData.githubLink && (
                <a href={birthdayData.githubLink} target="_blank" class="github-btn">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
                        <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                    </svg>
                    Visit GitHub
                </a>
            )}
        </div>
        
        <div class="photo-gallery">
            {birthdayData.photos.map((photo, index) => (
                <div class={`photo-card photo-card-${index}`}>
                    <div class="photo-wrapper">
                        <img src={photo.url} alt={photo.caption} />
                    </div>
                    <p class="photo-caption">{photo.caption}</p>
                </div>
            ))}
        </div>
    </div>

    <input id="volume" type="checkbox" style="display: none;"/>
    <label for="volume" title="Toggle sound">
        <svg class="icon-audio icon-audio-on" viewBox="0 0 24 24">
            <path d="M14,3.23V5.29C16.89,6.15 19,8.83 19,12C19,15.17 16.89,17.84 14,18.7V20.77C18,19.86 21,16.28 21,12C21,7.72 18,4.14 14,3.23M16.5,12C16.5,10.23 15.5,8.71 14,7.97V16C15.5,15.29 16.5,13.76 16.5,12M3,9V15H7L12,20V4L7,9H3Z"></path>
        </svg>
        <svg class="icon-audio icon-audio-off" viewBox="0 0 24 24" style="display: none;">
            <path d="M12,4L9.91,6.09L12,8.18M4.27,3L3,4.27L7.73,9H3V15H7L12,20V13.27L16.25,17.53C15.58,18.04 14.83,18.46 14,18.7V20.77C15.38,20.45 16.63,19.82 17.68,18.96L19.73,21L21,19.73L12,10.73M19,12C19,12.94 18.8,13.82 18.46,14.64L19.97,16.15C20.62,14.91 21,13.5 21,12C21,7.72 18,4.14 14,3.23V5.29C16.89,6.15 19,8.83 19,12M16.5,12C16.5,10.23 15.5,8.71 14,7.97V10.18L16.45,12.63C16.5,12.43 16.5,12.21 16.5,12Z"></path>
        </svg>
    </label>
</div>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Poppins:wght@300;600&display=swap');

    .birthday-container {
        --bg-image: url('./../../public/shq.JPG');
        --bg-overlay: rgba(0,0,0,0.1);

        --tongue: #c12115;
        --pupil: #fff;
        --icing: #f2f2f2;
        --stroke: #1a1a1a;
        --frosting-hue: 0;
        --lightness: 50;
        --flame: 0;
        --glow-hue: 40;
        --glow-saturation: 50;
        --glow-lightness: 35;
        --glow-alpha: 0.4;
        --transparency-alpha: 0;
        
        position: relative;
        width: 100%;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: var(--bg-image) center/cover no-repeat, hsl(180, 30%, calc(var(--lightness, 50) * 1%));
        transition: background 0.3s ease;
        transform: translateZ(0);
        will-change: background, transform;
    }

    .birthday-container::after {
        content: '';
        position: absolute;
        inset: 0;
        background: var(--bg-overlay);
        pointer-events: none;
        z-index: 0;
    }

    #balloonCanvas {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 1;
    }

    .birthday-button {
        position: relative;
        transform: scale(0.6) translateY(-2vh) translateZ(0);
        cursor: pointer;
        z-index: 10;
        will-change: transform, opacity;
        transition: transform 0.35s cubic-bezier(.22,1,.36,1), opacity 0.25s ease;
        transform-origin: center;
    }

    .birthday-button__button {
        position: relative;
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        outline: none;
        width: 400px;
        height: 150px;
    }

    .birthday-button__text {
        position: absolute;
        top: 0;
        left: 0;
        height: 100%;
        width: 100%;
        display: flex;
        text-align: center;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        font-family: 'Poppins', sans-serif;
        font-weight: bold;
        color: #fff;
        text-shadow: 0 2px 10px rgba(0,0,0,0.3);
        z-index: 2;
    }

    .birthday-button__button:active {
        transform: scale(0.95);
    }

    .birthday-button__button:hover .birthday-button__text {
        color: #ffeb3b;
        text-shadow: 0 0 20px rgba(255, 235, 59, 0.5);
    }

    /* Hilangkan efek lingkaran hitam/glow pada lilin */
    .birthday-button:before,
    .birthday-button:after {
        display: none !important;
        content: none !important;
        opacity: 0 !important;
    }

    /* Fade animasi untuk ekspresi wajah */
    .cake__face,
    .cake__face--straining {
        transition: opacity 0.25s cubic-bezier(.4,0,.2,1);
        will-change: opacity;
    }
    .cake__face--straining {
        opacity: 0;
        display: block !important;
        position: absolute;
        left: 0; top: 0;
        width: 100%; height: 100%;
        pointer-events: none;
    }
    .cake__face {
        opacity: 1;
        display: block !important;
        position: absolute;
        left: 0; top: 0;
        width: 100%; height: 100%;
        pointer-events: none;
    }
    .cake__eye-body { fill: var(--stroke); }
    .cake__eye-pupil { fill: var(--pupil); }
    .cake__tongue { fill: var(--tongue); }
    .cake__mouth-opening { fill: var(--stroke); stroke: var(--stroke); }
    .cake__sprinkle {
        --sprinkle: hsl(var(--sprinkle-hue, 0), 100%, 75%);
        fill: var(--sprinkle);
    }
    .cake__frosting--start, .cake__frosting--duplicate {
        fill: hsl(var(--frosting-hue, 0), 100%, 55%);
    }
    .candle__flame { opacity: var(--flame, 0); }
    .candle__flame-outer { fill: #ff711f; }
    .candle__flame-inner { fill: #edca1d; }

    label {
        height: 44px;
        width: 44px;
        position: fixed;
        bottom: 1rem;
        right: 1rem;
        cursor: pointer;
        z-index: 100;
    }
    
    label svg {
        height: 100%;
        width: 100%;
        fill: #476b6b;
    }

    /* Content Overlay Styles */
    .content-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 50;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        padding: 4rem 2rem;
        background: radial-gradient(circle, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0.7) 100%);
        backdrop-filter: blur(8px);
        overflow-y: auto;
        will-change: opacity, transform;
        transition: opacity 0.5s ease, transform 0.5s ease;
    }

    .message-card {
        text-align: center;
        color: white;
        max-width: 700px;
        margin-bottom: 4rem;
    }

    .target-name {
        font-size: clamp(3rem, 10vw, 5rem);
        font-family: 'Dancing Script', cursive;
        margin-bottom: 1rem;
        background: linear-gradient(to right, #ff9a9e 0%, #fecfef 99%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        text-shadow: 0 5px 15px rgba(255,154,158,0.3);
    }

    .birthday-message {
        font-size: clamp(1.1rem, 4vw, 1.4rem);
        line-height: 1.6;
        font-family: 'Poppins', sans-serif;
        opacity: 0.9;
        font-weight: 300;
    }

    .github-btn {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        margin-top: 2rem;
        padding: 12px 24px;
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 50px;
        color: white;
        text-decoration: none;
        font-family: 'Poppins', sans-serif;
        font-weight: 600;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .github-btn:hover {
        background: white;
        color: black;
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.2);
    }

    .photo-gallery {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 2.5rem;
        width: 100%;
        max-width: 1200px;
        padding-bottom: 4rem;
    }

    .photo-card {
        background: white;
        padding: 12px 12px 35px 12px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.4);
        transform: rotate(var(--rotation, 0deg));
        transition: transform 0.5s cubic-bezier(.22,1,.36,1), box-shadow .4s;
        will-change: transform;
        width: 280px;
    }

    .photo-card-0 { --rotation: -6deg; }
    .photo-card-1 { --rotation: 4deg; }
    .photo-card-2 { --rotation: -3deg; }

    .photo-wrapper {
        width: 100%;
        aspect-ratio: 1/1;
        overflow: hidden;
        margin-bottom: 20px;
    }

    .photo-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .photo-caption {
        font-family: 'Dancing Script', cursive;
        color: #222;
        font-size: 1.6rem;
        text-align: center;
    }

    @media (max-width: 600px) {
        .birthday-button { transform: scale(0.5); }
        .birthday-button__button { width: 300px; height: 120px; }
        .birthday-button__text { font-size: 1.4rem; }
        .photo-card { width: 240px; }
    }
</style>

<script is:inline define:vars={{ birthdayData }} src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script is:inline src="https://unpkg.com/splitting/dist/splitting.min.js"></script>
<script is:inline src="https://s3-us-west-2.amazonaws.com/s.cdpn.io/16327/MorphSVGPlugin3.min.js"></script>

<script is:inline define:vars={{ birthdayData }}>
    console.log('Birthday script loading...');
    
    // Tunggu semua script dan DOM siap
    window.addEventListener('load', function() {
        console.log('Window loaded, initializing...');
        initBirthdayAnimation();
    });

    function initBirthdayAnimation() {
        const { gsap } = window;
        
        if (!gsap) {
            console.error('GSAP not loaded!');
            return;
        }

        console.log('GSAP loaded:', gsap.version);
        
        // Inisialisasi Splitting jika ada
        if (window.Splitting) {
            try {
                window.Splitting();
                console.log('Splitting initialized');
            } catch (e) {
                console.warn('Splitting error:', e);
            }
        }

        const BTN = document.querySelector('.birthday-button__button');
        const CONTAINER = document.querySelector('.birthday-container');
        const OVERLAY = document.querySelector('.content-overlay');
        const CAKE = document.querySelector('.birthday-button__cake');
        
        if (!BTN) {
            console.error('Button not found!');
            return;
        }
        
        console.log('Elements found:', { BTN, CONTAINER, OVERLAY, CAKE });

        // Buat audio objects
        const SOUNDS = {
            CHEER: new Audio('https://s3-us-west-2.amazonaws.com/s.cdpn.io/605876/cheer.mp3'),
            MATCH: new Audio('https://s3-us-west-2.amazonaws.com/s.cdpn.io/605876/match-strike-trimmed.mp3'),
            TUNE: new Audio('https://s3-us-west-2.amazonaws.com/s.cdpn.io/605876/happy-birthday-trimmed.mp3'),
            ON: new Audio('https://assets.codepen.io/605876/switch-on.mp3'),
            BLOW: new Audio('https://s3-us-west-2.amazonaws.com/s.cdpn.io/605876/blow-out.mp3'),
            POP: new Audio('https://s3-us-west-2.amazonaws.com/s.cdpn.io/605876/pop-trimmed.mp3'),
            HORN: new Audio('https://s3-us-west-2.amazonaws.com/s.cdpn.io/605876/horn.mp3')
        };

        // Mute semua audio di awal
        Object.values(SOUNDS).forEach(sound => {
            sound.muted = true;
            sound.preload = 'auto';
        });

        // Fungsi reset
        const RESET = () => {
            console.log('Resetting animation...');
            
            // Matikan semua audio
            Object.values(SOUNDS).forEach(sound => {
                sound.pause();
                sound.currentTime = 0;
            });

            // Reset elemen ke keadaan semula
            gsap.set(BTN, { clearProps: true });
            gsap.set(OVERLAY, { 
                opacity: 0, 
                display: 'none',
                pointerEvents: 'none'
            });
            gsap.set('#balloonCanvas', { 
                opacity: 0, 
                display: 'none' 
            });

            // Hentikan semua timeline
            if (window.MASTER_TL) {
                window.MASTER_TL.kill();
                window.MASTER_TL = null;
            }

            // Mulai ulang animasi teks
            initBirthdayAnimation();
        };

        // Animasi saat tombol diklik
        BTN.addEventListener('click', function() {
            console.log('Button clicked, starting animation...');
            
            // Aktifkan suara
            Object.values(SOUNDS).forEach(sound => {
                sound.muted = false;
            });

            // Timeline utama
            window.MASTER_TL = gsap.timeline({ 
                onComplete: () => console.log('Animation complete') 
            });
            
            MASTER_TL
            .to('.birthday-button__text', {
                duration: 0.8,
                y: -50,
                opacity: 0,
                ease: 'power2.in',
                onComplete: () => {
                    gsap.set('.birthday-button__text', { y: 0, opacity: 1 });
                }
            })
            .to('#balloonCanvas', {
                duration: 1.2,
                opacity: 1,
                display: 'block',
                ease: 'power2.out'
            })
            .to(OVERLAY, {
                duration: 1.2,
                opacity: 1,
                display: 'flex',
                pointerEvents: 'auto',
                ease: 'power2.out'
            }, '-=1')
            .call(() => {
                // Putar balon
                gsap.to('#balloonCanvas', {
                    duration: 1.5,
                    rotation: 360,
                    ease: 'power2.inOut',
                    repeat: -1
                });
            })
            .call(() => {
                // Putar teks
                gsap.to('.birthday-button__text', {
                    duration: 1.5,
                    rotation: 360,
                    ease: 'power2.inOut',
                    repeat: -1
                });
            }, '-=1.2')
            .add('end');
        });
    }
</script>
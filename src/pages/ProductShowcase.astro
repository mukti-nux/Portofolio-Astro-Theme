---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import ImageGallery from "../components/ImageGallery.tsx";
import ReviewsSection from "../components/ReviewsSection.tsx";
import PaymentFlow from "../components/PaymentFlow.tsx";
import productShop from "../data/productShop";

// Get product ID from URL query parameter
const url = new URL(Astro.request.url);
const productId = url.searchParams.get("id");

// Find the product
const product = productShop.find((p) => p.id === productId);

// If product not found, redirect to store
if (!product) {
    return Astro.redirect("/StorePage");
}

const formatPrice = (price: number) => {
    return new Intl.NumberFormat("id-ID", {
        style: "currency",
        currency: "IDR",
        minimumFractionDigits: 0,
    }).format(price);
};
---

<Layout showImage={true} title={product.title}>
    <div class="relative pt-36 pb-20" id="product-showcase">
        <Container>
            <!-- Background gradient -->
            <div
                aria-hidden="true"
                class="absolute inset-0 h-max w-full m-auto grid grid-cols-2 -space-x-52 opacity-40 dark:opacity-20"
            >
                <div
                    class="blur-[106px] h-56 bg-gradient-to-br from-primary to-purple-400 dark:from-blue-700"
                >
                </div>
                <div
                    class="blur-[106px] h-32 bg-gradient-to-r from-cyan-400 to-sky-300 dark:to-indigo-600"
                >
                </div>
            </div>

            <div class="relative">
                <!-- Back Button -->
                <a
                    href="/StorePage"
                    class="inline-flex items-center gap-2 text-primary hover:text-primary/80 transition mb-8"
                >
                    <svg
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 19l-7-7 7-7"></path>
                    </svg>
                    Back to Store
                </a>

                <!-- Product Showcase Grid -->
                <div class="grid lg:grid-cols-2 gap-12">
                    <!-- Left: Image Gallery -->
                    <div>
                        <ImageGallery
                            images={product.images}
                            productTitle={product.title}
                            client:load
                        />
                    </div>

                    <!-- Right: Product Info -->
                    <div class="space-y-6">
                        <!-- Category Badge -->
                        <span
                            class="inline-block px-4 py-2 text-sm font-semibold text-primary bg-primary/10 rounded-full"
                        >
                            {product.category}
                        </span>

                        <!-- Title -->
                        <h1
                            class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white"
                        >
                            {product.title}
                        </h1>

                        <!-- Rating -->
                        <div class="flex items-center gap-3">
                            <div class="flex text-2xl">
                                {
                                    Array.from({
                                        length: Math.floor(product.rating),
                                    }).map((_, i) => (
                                        <span key={i} class="text-yellow-400">
                                            ★
                                        </span>
                                    ))
                                }
                                {
                                    product.rating % 1 !== 0 && (
                                        <span class="text-yellow-400">☆</span>
                                    )
                                }
                                {
                                    Array.from({
                                        length: 5 - Math.ceil(product.rating),
                                    }).map((_, i) => (
                                        <span
                                            key={i}
                                            class="text-gray-300 dark:text-gray-600"
                                        >
                                            ★
                                        </span>
                                    ))
                                }
                            </div>
                            <span
                                class="text-lg text-gray-600 dark:text-gray-400"
                            >
                                {product.rating} ({product.reviews.length} ulasan)
                            </span>
                        </div>

                        <!-- Price -->
                        <div class="text-4xl font-bold text-primary">
                            {formatPrice(product.price)}
                        </div>

                        <!-- Stock Status -->
                        <div class="flex items-center gap-2">
                            {
                                product.stock > 0 ? (
                                    <>
                                        <div class="w-3 h-3 rounded-full bg-green-500" />
                                        <span class="text-gray-700 dark:text-gray-300">
                                            Stock:{" "}
                                            <strong>{product.stock}</strong>
                                        </span>
                                    </>
                                ) : (
                                    <>
                                        <div class="w-3 h-3 rounded-full bg-red-500" />
                                        <span class="text-red-600 dark:text-red-400 font-semibold">
                                            Sold Out
                                        </span>
                                    </>
                                )
                            }
                        </div>

                        <!-- Description -->
                        <div class="prose dark:prose-invert max-w-none">
                            <p class="text-lg text-gray-700 dark:text-gray-300">
                                {product.detailedDescription}
                            </p>
                        </div>

                        <!-- Features -->
                        <div class="space-y-3">
                            <h3
                                class="text-xl font-semibold text-gray-900 dark:text-white"
                            >
                                Features:
                            </h3>
                            <ul class="space-y-2">
                                {
                                    product.features.map((feature) => (
                                        <li class="flex items-start gap-3">
                                            <svg
                                                class="w-6 h-6 text-green-500 flex-shrink-0 mt-0.5"
                                                fill="none"
                                                stroke="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M5 13l4 4L19 7"
                                                />
                                            </svg>
                                            <span class="text-gray-700 dark:text-gray-300">
                                                {feature}
                                            </span>
                                        </li>
                                    ))
                                }
                            </ul>
                        </div>

                        <!-- Buy Button -->
                        <button
                            id="buyNowBtn"
                            data-product-id={product.id}
                            data-product-title={product.title}
                            data-product-price={product.price}
                            data-product-image={product.imageUrl}
                            data-product-category={product.category}
                            disabled={product.stock === 0}
                            class={`w-full py-4 px-8 rounded-xl font-bold text-lg transition-all duration-300 ${
                                product.stock === 0
                                    ? "bg-gray-400 text-gray-200 cursor-not-allowed"
                                    : "bg-gradient-to-r from-primary to-purple-500 text-white hover:shadow-2xl hover:scale-105"
                            }`}
                        >
                            {
                                product.stock === 0
                                    ? "STOK HABIS"
                                    : "BELI SEKARANG"
                            }
                        </button>
                    </div>
                </div>

                <!-- Reviews Section -->
                <div class="mt-20">
                    <h2
                        class="text-3xl font-bold text-gray-900 dark:text-white mb-8"
                    >
                        Reviews
                    </h2>
                    <ReviewsSection
                        reviews={product.reviews}
                        averageRating={product.rating}
                        client:load
                    />
                </div>
            </div>
        </Container>
    </div>

    <!-- Payment Flow Component -->
    <PaymentFlow
        product={{
            id: product.id,
            title: product.title,
            price: product.price,
            imageUrl: product.imageUrl,
            category: product.category,
            stock: product.stock,
        }}
        client:load
    />

    <script>
        // Handle buy button click - open payment method modal
        const buyBtn = document.getElementById("buyNowBtn");
        if (buyBtn) {
            buyBtn.addEventListener("click", () => {
                // Dispatch custom event to open payment method modal
                window.dispatchEvent(new CustomEvent("openPaymentModal"));
            });
        }
    </script>
</Layout>

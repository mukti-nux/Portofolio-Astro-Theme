---
import Layout from "../layouts/Layout.astro";
import { birthdayConfig, type BirthdayConfig } from "../config/birthdayConfig";
---

<Layout title="Happy Birthday" hideHeader={true}>
  <!-- Dynamic Background from Config -->
  <div id="background-container" class="fixed inset-0 -z-20 overflow-hidden">
    <img
      id="bg-image"
      src=""
      alt="Background"
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-black/70"></div>
  </div>

  <!-- Balloon Canvas -->
  <canvas
    id="balloon-canvas"
    class="fixed inset-0 w-full h-full pointer-events-none"
    style="z-index: 30;"></canvas>

  <!-- Main Container -->
  <div class="fixed inset-0 flex items-center justify-center">
    <!-- Trigger Button (Initial State) -->
    <div id="trigger-container" class="text-center">
      <button id="trigger-btn" class="birthday-trigger-btn">
        <span class="text-4xl mb-4 block">🎂</span>
        <span class="text-2xl font-bold text-white">Click to Celebrate!</span>
      </button>
    </div>

    <!-- Birthday Content (Hidden Initially) -->
    <div id="birthday-content" class="hidden">
      <!-- Photos Container (Behind Cake) -->
      <div id="photos-container" class="absolute" style="z-index: 10;">
        <img id="photo1" class="birthday-photo" src="" alt="Photo 1" />
        <img id="photo2" class="birthday-photo" src="" alt="Photo 2" />
        <img id="photo3" class="birthday-photo" src="" alt="Photo 3" />
      </div>

      <!-- Cake Container -->
      <div
        id="cake-container"
        class="birthday-cake-wrapper"
        style="z-index: 20;"
      >
        <svg
          class="birthday-cake"
          xmlns="http://www.w3.org/2000/svg"
          xmlns:xlink="http://www.w3.org/1999/xlink"
          viewBox="0 0 76.609 47.643"
        >
          <defs>
            <g id="candle" transform="translate(-48.82 -137.74)">
              <rect
                ry=".567"
                y="147.888"
                x="72.548"
                height="12.001"
                width="4.252"
                fill="#ececec"></rect>
              <g class="candle__flame">
                <path
                  class="candle__flame-outer"
                  d="M75.672 145.92c.608 1.207.086 2.224-.749 2.224s-1.512-.037-1.512-1.388.558-3.566 1.98-3.973c1.007-.288-.855.884.281 3.138z"
                  fill="#f60"></path>
                <path
                  class="candle__flame-inner"
                  d="M75.081 146.449c.41.51.266 1.043-.13 1.128-.394.084-.682-.228-.822-.866 0 0-.13-1.382.502-1.719.447-.238-.315.505.45 1.457z"
                  fill="#ff0"></path>
              </g>
            </g>
            <clipPath id="face-clip">
              <rect
                transform="translate(-48.82 -138.799)"
                width="63.5"
                height="26.458"
                x="55.374"
                y="159.984"
                ry="3.402"></rect>
            </clipPath>
            <clipPath id="sprinkle-clip">
              <rect
                width="63.5"
                height="26.458"
                x="55.374"
                y="159.984"
                ry="3.402"></rect>
            </clipPath>
            <g id="sprinkles" transform="translate(63.93)">
              <rect
                class="cake__sprinkle"
                transform="rotate(-44.064)"
                ry=".567"
                y="167.592"
                x="-91.837"
                height="1.228"
                width="3.307"></rect>
              <rect
                class="cake__sprinkle"
                transform="rotate(127.01)"
                ry=".567"
                y="165.35"
                x="76.642"
                height="1.228"
                width="3.307"></rect>
              <rect
                class="cake__sprinkle"
                transform="rotate(85.232)"
                width="3.307"
                height="1.228"
                x="182.37"
                y="3.842"
                ry=".567"></rect>
              <rect
                class="cake__sprinkle"
                transform="rotate(136.794)"
                ry=".567"
                y="-137.013"
                x="122.349"
                height="1.228"
                width="3.307"></rect>
              <rect
                class="cake__sprinkle"
                transform="rotate(-28.569)"
                width="3.307"
                height="1.228"
                x="-90.997"
                y="160.466"
                ry=".567"></rect>
            </g>
            <path
              id="frosting"
              d="M58.311 159.194c-1.915 0-3.283-.087-3.986 1.098-.392.661-.073 1.766.529 2.243 1.054.834 2.689 0 4.034 0H115.36c1.344 0 2.979.834 4.033 0 .602-.477.921-1.582.53-2.243-.703-1.185-2.072-1.098-3.987-1.098z"
            ></path>
          </defs>
          <g class="cake-decoration" transform="translate(-48.82 -138.799)">
            <g class="cake__frosting-group">
              <use xlink:href="#frosting" fill="#ff69b4"></use>
            </g>
            <g class="cake__sprinkles-group" clip-path="url(#sprinkle-clip)">
              <use xlink:href="#sprinkles"></use>
            </g>
          </g>
          <g clip-path="url(#face-clip)">
            <g class="cake__face" transform="translate(-48.82 -138.799)">
              <g class="cake__eyes">
                <g
                  class="cake__eye"
                  transform="matrix(1.38031 0 0 1.38031 34.723 -33.58)"
                >
                  <circle
                    class="cake__eye-body"
                    cx="29.86"
                    cy="149.022"
                    r="2.457"
                    fill="#1a1a1a"></circle>
                  <circle
                    class="cake__eye-pupil"
                    cx="28.773"
                    cy="148.162"
                    r=".756"
                    fill="#fff"></circle>
                </g>
                <g
                  class="cake__eye"
                  transform="matrix(1.38031 0 0 1.38031 57.092 -33.58)"
                >
                  <circle
                    class="cake__eye-body"
                    r="2.457"
                    cy="149.022"
                    cx="29.86"
                    fill="#1a1a1a"></circle>
                  <circle
                    class="cake__eye-pupil"
                    r=".756"
                    cy="148.162"
                    cx="28.773"
                    fill="#fff"></circle>
                </g>
              </g>
              <g class="cake__mouth">
                <path
                  class="cake__mouth-opening"
                  d="M83.607 174.436a3.652 3.652 0 003.518 2.674 3.652 3.652 0 003.515-2.674z"
                  stroke="#1a1a1a"
                  fill="#1a1a1a"></path>
              </g>
            </g>
          </g>
          <g class="cake__candles">
            <g class="cake__candle candle-1">
              <use xlink:href="#candle"></use>
            </g>
            <g class="cake__candle candle-2">
              <use xlink:href="#candle" transform="translate(25 0)"></use>
            </g>
            <g class="cake__candle candle-3">
              <use xlink:href="#candle" transform="translate(12 0.5)"></use>
            </g>
          </g>
        </svg>
      </div>

      <!-- Greeting Message (Below Cake) -->
      <div
        id="greeting-container"
        class="absolute bottom-20 left-1/2 transform -translate-x-1/2 text-center px-8 max-w-2xl"
        style="z-index: 15;"
      >
        <p
          id="greeting-text"
          class="text-white text-xl md:text-2xl font-semibold drop-shadow-lg"
        >
        </p>
      </div>
    </div>
  </div>

  <!-- Dark Overlay for Candle Lighting -->
  <div
    id="dark-overlay"
    class="fixed inset-0 bg-black opacity-0 pointer-events-none"
    style="z-index: 25;"
  >
  </div>

  <style>
    .birthday-trigger-btn {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      padding: 2rem 3rem;
      border-radius: 20px;
      border: none;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    .birthday-trigger-btn:hover {
      transform: scale(1.05);
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
    }

    .birthday-cake-wrapper {
      position: relative;
      width: 300px;
      height: 200px;
    }

    .birthday-cake {
      width: 100%;
      height: 100%;
      filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.3));
    }

    .cake__sprinkle {
      fill: hsl(calc(var(--sprinkle-hue, 0) * 1deg), 100%, 75%);
    }

    .candle__flame {
      opacity: 0;
      transform-origin: center;
    }

    .candle__flame.lit {
      opacity: 1;
      animation: flicker 0.3s infinite alternate;
    }

    @keyframes flicker {
      0% {
        transform: scale(1) translateY(0);
      }
      100% {
        transform: scale(1.1) translateY(-2px);
      }
    }

    .birthday-photo {
      position: absolute;
      width: 150px;
      height: 150px;
      object-fit: cover;
      border-radius: 15px;
      border: 4px solid white;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      opacity: 0;
      transform: translateY(100vh);
    }

    #photo1 {
      left: -200px;
      top: -50px;
    }
    #photo2 {
      right: -200px;
      top: -50px;
    }
    #photo3 {
      left: 50%;
      transform: translateX(-50%) translateY(100vh);
      top: -180px;
    }

    @media (max-width: 768px) {
      .birthday-cake-wrapper {
        width: 200px;
        height: 150px;
      }

      .birthday-photo {
        width: 100px;
        height: 100px;
      }

      #photo1 {
        left: -120px;
        top: -30px;
      }
      #photo2 {
        right: -120px;
        top: -30px;
      }
      #photo3 {
        top: -120px;
      }
    }
  </style>

  <script>
    import { gsap } from "gsap";
    import { birthdayConfig } from "../config/birthdayConfig";

    // Load configuration
    const config = birthdayConfig;

    // Set background image
    const bgImage = document.getElementById(
      "bg-image",
    ) as HTMLImageElement | null;
    if (bgImage) bgImage.src = config.backgroundImage;

    // Set photos
    const photo1 = document.getElementById("photo1") as HTMLImageElement | null;
    const photo2 = document.getElementById("photo2") as HTMLImageElement | null;
    const photo3 = document.getElementById("photo3") as HTMLImageElement | null;
    if (photo1 && config.photos[0]) photo1.src = config.photos[0];
    if (photo2 && config.photos[1]) photo2.src = config.photos[1];
    if (photo3 && config.photos[2]) photo3.src = config.photos[2];

    // Set greeting
    const greetingText = document.getElementById(
      "greeting-text",
    ) as HTMLParagraphElement | null;
    if (greetingText) greetingText.textContent = config.greeting;

    // Animation state
    let animationPhase = "initial";
    let canvasAnimationStarted = false;

    // Trigger button click
    const triggerBtn = document.getElementById("trigger-btn");
    const triggerContainer = document.getElementById("trigger-container");
    const birthdayContent = document.getElementById("birthday-content");
    const cakeContainer = document.getElementById("cake-container");
    const darkOverlay = document.getElementById("dark-overlay");

    triggerBtn?.addEventListener("click", () => {
      // Hide trigger, show content
      if (!triggerContainer || !birthdayContent || !cakeContainer) return;

      gsap.to(triggerContainer, {
        opacity: 0,
        scale: 0.8,
        duration: 0.5,
        onComplete: () => {
          if (triggerContainer) triggerContainer.style.display = "none";
          if (birthdayContent) birthdayContent.classList.remove("hidden");

          // Animate cake appearing
          gsap.fromTo(
            cakeContainer,
            { scale: 0, rotation: -180, opacity: 0 },
            {
              scale: 1,
              rotation: 0,
              opacity: 1,
              duration: 1,
              ease: "elastic.out(1, 0.5)",
              onComplete: () => {
                animationPhase = "cake-visible";
              },
            },
          );
        },
      });
    });

    // Click anywhere to light candles
    document.addEventListener("click", (e) => {
      if (animationPhase === "cake-visible") {
        animationPhase = "lighting-candles";
        lightCandles();
      }
    });

    function lightCandles() {
      if (!darkOverlay) return;

      // Darken screen
      gsap.to(darkOverlay, {
        opacity: 0.9,
        duration: 0.5,
        onComplete: () => {
          // Light candles one by one
          const candles = document.querySelectorAll(".candle__flame");

          candles.forEach((candle, index) => {
            setTimeout(() => {
              candle.classList.add("lit");

              // After last candle, return to normal
              if (index === candles.length - 1) {
                setTimeout(() => {
                  gsap.to(darkOverlay, {
                    opacity: 0,
                    duration: 0.5,
                    onComplete: () => {
                      animationPhase = "candles-lit";
                      startBalloons();
                    },
                  });
                }, 500);
              }
            }, index * 500);
          });
        },
      });
    }

    // Balloon Animation
    function startBalloons() {
      if (canvasAnimationStarted) return;
      canvasAnimationStarted = true;

      const canvas = document.getElementById(
        "balloon-canvas",
      ) as HTMLCanvasElement | null;
      if (!canvas) return;
      const ctx = canvas.getContext("2d");
      if (!ctx) return;
      let w = (canvas.width = window.innerWidth);
      let h = (canvas.height = window.innerHeight);

      const balloons = [];
      const balloonCount = 15;

      class Balloon {
        constructor() {
          this.x = Math.random() * w;
          this.y = h + 100;
          this.size = 30 + Math.random() * 20;
          this.speed = 1 + Math.random() * 2;
          this.hue = Math.random() * 360;
          this.sway = Math.random() * 2 - 1;
        }

        update() {
          this.y -= this.speed;
          this.x += Math.sin(this.y * 0.01) * this.sway;
        }

        draw() {
          ctx.fillStyle = `hsl(${this.hue}, 80%, 60%)`;
          ctx.beginPath();
          ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
          ctx.fill();

          // String
          ctx.strokeStyle = `hsl(${this.hue}, 80%, 40%)`;
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(this.x, this.y + this.size);
          ctx.lineTo(this.x, this.y + this.size + 30);
          ctx.stroke();
        }

        isOffScreen() {
          return this.y < -100;
        }
      }

      // Create balloons
      for (let i = 0; i < balloonCount; i++) {
        setTimeout(() => {
          balloons.push(new Balloon());
        }, i * 100);
      }

      // Draw name with balloons
      let nameDrawn = false;

      function animate() {
        ctx.clearRect(0, 0, w, h);

        // Update and draw balloons
        for (let i = balloons.length - 1; i >= 0; i--) {
          balloons[i].update();
          balloons[i].draw();

          if (balloons[i].isOffScreen()) {
            balloons.splice(i, 1);
          }
        }

        // Draw name
        if (!nameDrawn && balloons.length > 5) {
          nameDrawn = true;
          ctx.font = "bold 60px Arial";
          ctx.fillStyle = "white";
          ctx.strokeStyle = "#667eea";
          ctx.lineWidth = 3;
          ctx.textAlign = "center";
          ctx.strokeText(config.name, w / 2, h / 2 - 150);
          ctx.fillText(config.name, w / 2, h / 2 - 150);
        }

        // Continue animation or show photos
        if (balloons.length > 0) {
          requestAnimationFrame(animate);
        } else {
          setTimeout(showPhotos, 1000);
        }
      }

      animate();

      // Resize handler
      window.addEventListener("resize", () => {
        w = canvas.width = window.innerWidth;
        h = canvas.height = window.innerHeight;
      });
    }

    // Show photos
    function showPhotos() {
      const photos = [photo1, photo2, photo3];

      photos.forEach((photo, index) => {
        gsap.to(photo, {
          y: 0,
          opacity: 1,
          duration: 1.5,
          delay: index * 0.3,
          ease: "power2.out",
        });
      });

      // Show greeting after photos
      setTimeout(() => {
        gsap.to("#greeting-container", {
          opacity: 1,
          y: 0,
          duration: 1,
          ease: "power2.out",
        });
      }, 2000);
    }
  </script>
</Layout>

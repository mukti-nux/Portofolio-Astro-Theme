---
// src/components/GameCanvas.astro
---

<div class="game-area">
  <!-- Game Header -->
  <div class="game-header">
    <div class="game-info">
      <h3 class="game-title">Teh Kota — Jualan Cepat!</h3>
      <p class="game-instruction">Klik pelanggan untuk melayani. Dapatkan uang, upgrade gerobak!</p>
    </div>
    <div class="game-stats">
      <div class="stat-money">Uang: Rp <span id="money">0</span></div>
      <div class="stat-secondary">
        Skor: <span id="score">0</span> | Hari: <span id="day">1</span>
      </div>
    </div>
  </div>

  <!-- Canvas Container -->
  <div class="canvas-wrapper">
    <canvas 
      id="gameCanvas" 
      width="560" 
      height="420"
      aria-label="Game canvas untuk game Teh Kota"
    ></canvas>
  </div>

  <!-- Game Controls -->
  <div class="game-controls">
    <button id="startBtn" class="control-btn control-btn--primary">
      Mulai Game
    </button>
    <button id="pauseBtn" class="control-btn control-btn--secondary">
      Jeda
    </button>
    <button id="resetBtn" class="control-btn control-btn--secondary">
      Reset
    </button>
    <div class="game-tip">
      💡 Level pelanggan meningkat tiap 10 skor
    </div>
  </div>
</div>

<style>
  .game-area {
    background: white;
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    border: 1px solid #e5e5e5;
  }

  .dark .game-area {
    background: #2d3748;
    border-color: #4a5568;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
  }

  .game-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .game-info {
    flex: 1;
    min-width: 200px;
  }

  .game-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #b7410e;
    margin: 0 0 0.5rem 0;
    line-height: 1.3;
  }

  .dark .game-title {
    color: #e76f51;
  }

  .game-instruction {
    font-size: 0.9rem;
    color: #666;
    margin: 0;
    line-height: 1.4;
  }

  .dark .game-instruction {
    color: #a0aec0;
  }

  .game-stats {
    text-align: right;
    flex-shrink: 0;
  }

  .stat-money {
    font-weight: 700;
    font-size: 1.1rem;
    color: #2d3748;
    margin-bottom: 0.25rem;
  }

  .dark .stat-money {
    color: #e2e8f0;
  }

  .stat-secondary {
    font-size: 0.85rem;
    color: #666;
  }

  .dark .stat-secondary {
    color: #a0aec0;
  }

  .canvas-wrapper {
    position: relative;
    width: 100%;
    max-width: 560px;
    margin: 0 auto;
    border-radius: 12px;
    overflow: hidden;
    background: linear-gradient(135deg, #fff5f5 0%, #fff 100%);
    border: 2px solid #e5e5e5;
  }

  .dark .canvas-wrapper {
    background: linear-gradient(135deg, #2d3748 0%, #4a5568 100%);
    border-color: #4a5568;
  }

  #gameCanvas {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4/3;
    background: linear-gradient(#fff, #f8f4f0);
  }

  .dark #gameCanvas {
    background: linear-gradient(#4a5568, #2d3748);
  }

  .game-controls {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }

  .control-btn {
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s ease;
    min-height: 44px;
    flex: 1;
    min-width: 100px;
  }

  .control-btn--primary {
    background: #b7410e;
    color: white;
  }

  .control-btn--primary:hover {
    background: #9a3610;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(183, 65, 14, 0.3);
  }

  .control-btn--secondary {
    background: #f7f7f7;
    color: #374151;
    border: 1px solid #e5e5e5;
  }

  .control-btn--secondary:hover {
    background: #e5e5e5;
    transform: translateY(-1px);
  }

  .dark .control-btn--secondary {
    background: #4a5568;
    color: #e2e8f0;
    border-color: #718096;
  }

  .dark .control-btn--secondary:hover {
    background: #2d3748;
  }

  .game-tip {
    margin-left: auto;
    font-size: 0.8rem;
    color: #666;
    text-align: center;
    padding: 0.5rem;
    background: rgba(183, 65, 14, 0.05);
    border-radius: 6px;
    border-left: 3px solid #b7410e;
  }

  .dark .game-tip {
    color: #a0aec0;
    background: rgba(231, 111, 81, 0.1);
    border-left-color: #e76f51;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .game-area {
      padding: 1rem;
    }

    .game-header {
      flex-direction: column;
      gap: 1rem;
    }

    .game-stats {
      text-align: left;
      width: 100%;
    }

    .game-controls {
      gap: 0.5rem;
    }

    .game-tip {
      margin-left: 0;
      width: 100%;
      order: -1;
    }
  }

  @media (max-width: 480px) {
    .game-controls {
      flex-direction: column;
    }

    .control-btn {
      width: 100%;
    }

    .canvas-wrapper {
      border-radius: 8px;
    }
  }
</style>
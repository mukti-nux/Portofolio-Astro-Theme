    </div>
    <div class="relative min-h-screen bg-cover bg-center" style="background-image: url('https://github.com/mukti-nux/Framer-asset/blob/main/SBJ_0833.JPG?raw=true');">
        <div class="absolute inset-0 bg-black/60"></div>
    <Container>
       <HeroSectionMotion />

        <div class="relative pt-36 ml-auto">
            <div class="lg:w-2/3 text-center mx-auto">

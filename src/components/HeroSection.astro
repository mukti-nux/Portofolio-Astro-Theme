                <p class="mt-8 text-gray-700 dark:text-gray-300" id="deskripdiri">Hi, my name is Hasan Mukti Abdulloh. I was born in Magelang and taught myself photography and website development at home. I'm the head of the PIP division for the Muhammadiyah Student Association branch at Muhammadiyah Tempuran Junior High School.</p>
                <div class="mt-16 flex flex-wrap justify-center gap-y-4 gap-x-6">
                    <a
                      href="/SubscirbePage"
                      class="tombolhero1 relative flex h-11 w-full items-center justify-center px-6 before:absolute before:inset-0 before:rounded-full before:bg-primary before:transition before:duration-300 hover:before:scale-105 active:duration-75 active:before:scale-95 sm:w-max"
                      
                    >
                      <span class="relative text-base font-semibold text-white"
                        >Get started</span
                      >
                    </a>
                    <a
                      href="https://portofoliomukti.framer.website"
                      class="tombolhero2 relative flex h-11 w-full items-center justify-center px-6 before:absolute before:inset-0 before:rounded-full before:border before:border-transparent before:bg-primary/10 before:bg-gradient-to-b before:transition before:duration-300 hover:before:scale-105 active:duration-75 active:before:scale-95 dark:before:border-gray-700 dark:before:bg-gray-800 sm:w-max"
                    
                    >
                      <span
                        class="relative text-base font-semibold text-primary dark:text-white"
                        >Learn more</span
                      > 
                    </a>
                    <a
                      href="https://trakteer.id/hasan_mukti_abdulloh"
                      class="tombolhero3 relative flex h-11 w-full items-center justify-center px-6 before:absolute before:inset-0 before:rounded-full before:bg-primary before:transition before:duration-300 hover:before:scale-105 active:duration-75 active:before:scale-95 sm:w-max"
                                     
                    >
                      <span class="relative text-base font-semibold text-white"
                        >Support Me!</span
                      >
                    </a>
                </div>
                <div class="hidden py-8 mt-16 border-y border-gray-100 dark:border-gray-800 sm:flex justify-between">
                    <div class="text-center">
                        <h6 class="text-lg font-semibold text-gray-700 dark:text-white">Gear</h6>
                        <p class="mt-2 text-gray-500">Nikon D5600</p>
                    </div>
                    <div class="text-center justify-center">
                        <h6 class="text-lg font-semibold text-gray-700 dark:text-white">Education currently being taught</h6>
                        <p class="mt-2 text-gray-500">Muhammadiyah Tempuran Junior High School</p>
                    </div>
                    <div class="text-center">
                        <h6 class="text-lg font-semibold text-gray-700 dark:text-white">Operating System</h6>
                        <p class="mt-2 text-gray-500">Windows & WSL</p>
                    </div>
                </div>
            </div>
            <div class="mt-12 grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6">
                <div class="p-4 flex items-center h-[120px] grayscale justify-center transition duration-200 hover:grayscale-0">
                    <img src="./images/clients/microsoft.svg" class="max-h-[120px] w-auto scale-130" loading="lazy" alt="client logo" width="" height="" />
                  </div>
                <div class="p-4 flex items-center h-[120px] grayscale justify-center transition duration-200 hover:grayscale-0">
                  <img src="./images/clients/google-drive.svg" class="max-h-[120px] w-auto scale-135" loading="lazy" alt="client logo" width="" height="" />
                </div>
                <div class="p-4 flex items-center h-[100px] grayscale justify-center transition duration-200 hover:grayscale-0">
                  <img src="./images/logoshazqi.svg" class="max-h-full w-auto" loading="lazy" alt="client logo" width="" height="" />
                </div>
                <div class="p-4 flex items-center h-[100px] grayscale justify-center transition duration-200 hover:grayscale-0">
                    <img src="./images/clients/logoporto.svg" class="max-h-full w-auto" loading="lazy" alt="client logo" width="" height="" />
                  </div>
                  <div class="p-4 flex items-center h-[80px] grayscale justify-center transition duration-200 hover:grayscale-0">
                    <img src="./images/clients/framer.svg" class="max-h-[50px] w-auto" loading="lazy" alt="client logo" width="" height="" />
                  </div>
                <div class="p-4 flex items-center h-[80px] grayscale justify-center transition duration-200 hover:grayscale-0">
                    <img src="./images/clients/chatgpt.svg" class="max-h-[45px] w-auto" loading="lazy" alt="client logo" width="" height="" />
                </div>
              </div>
          </div>
        </div>
      </div>
       
    </Container>
</div>

<style>
  @keyframes fadeOut {
  from {
    opacity: 1;
    transform: translateY(0);
  }
  to {
    opacity: 0;
    transform: translateY(20px);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.animasi-fade-in {
  animation: fadeIn 0.8s ease-out forwards;
}

.animasi-fade-out {
  animation: fadeOut 0.8s ease-out forwards;
}
</style>

<script>
  import { useEffect } from "preact/hooks";

  export default function HeroSectionMotion() {
    useEffect(() => {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const target = entry.target;
            if (entry.isIntersecting) {
              target.classList.remove("animasi-fade-out");
              target.classList.add("animasi-fade-in");
            } else {
              target.classList.remove("animasi-fade-in");
              target.classList.add("animasi-fade-out");
            }
          });
        },
        { threshold: 0.1 }
      );

      const elements = document.querySelectorAll(".animasi-teks");
      if (elements.length > 0) {
        elements.forEach((el) => observer.observe(el));
      }

      return () => observer.disconnect();
    }, []);

    return null;
  }
</script>
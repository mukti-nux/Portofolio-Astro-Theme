---
import Container from "./Container.astro";
// Contoh data: bisa kamu ganti dengan path atau inline SVG asli
const contributors = [
  { name: "Allah", svg: "/svg/mukti.svg" },
  { name: "Shazqi", svg: "/svg/shazqi.svg" },
  { name: "Raka", svg: "/svg/raka.svg" },
  { name: "Nadya", svg: "/svg/nadya.svg" },
];
---
<style>
  .ticker-container {
    overflow: hidden;
    white-space: nowrap;
    position: relative;
  }

  .ticker-track {
    display: inline-block;
    animation: ticker-scroll 25s linear infinite;
  }

  @keyframes ticker-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-100%); }
  }

  .contributor {
    display: inline-block;
    margin-right: 3rem;
    position: relative;
    width: 80px;
    height: 80px;
    cursor: pointer;
    transition: transform 0.2s;
  }

  .contributor:hover {
    transform: scale(1.1);
  }

  .tooltip {
    position: absolute;
    bottom: -1.8rem;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.7);
    color: #fff;
    padding: 0.3rem 0.6rem;
    border-radius: 6px;
    font-size: 0.75rem;
    opacity: 0;
    transition: opacity 0.2s;
    pointer-events: none;
    white-space: nowrap;
  }

  .contributor:hover .tooltip {
    opacity: 1;
  }
</style>

<Container>

<div class="ticker-container bg-gray-100 py-6">
  <div class="ticker-track">
    {contributors.concat(contributors).map((person, index) => (
      <div class="contributor" key={index}>
        <img src={person.svg} alt={person.name} width="80" height="80" />
        <div class="tooltip">{person.name}</div>
      </div>
    ))}
  </div>
</div>

<Container>
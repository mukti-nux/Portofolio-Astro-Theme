---
import Container from './../components/Container.astro';
import { produkList } from './../data/productList';
---

<link rel="stylesheet" href="/carousel.css">

<div class="carousel">
  <Container>
  <div class="list">
      {produkList.map((produk) => (
        <div class="item">
          <img src={produk.gambar} alt={produk.nama} />
          <div class="introduce">
            <div class="title">{produk.judul}</div>
            <div class="topic">{produk.nama}</div>
            <div class="des">
              {produk.deskripsiSingkat}
            </div>
            <button class="seeMore">SEE MORE &#8599;</button>
          </div>
          <div class="detail">
            <div class="title">{produk.judulDetail}</div>
            <div class="des">
              {produk.deskripsiLengkap}
            </div>
            <div class="specifications">
              {Object.entries(produk.spesifikasi).map(([key, value]) => (
                <div>
                  <p>{key}</p>
                  <p>{value}</p>
                </div>
              ))}
            </div>
            <div class="checkout">
              <button>ADD TO CART</button>
              <button>CHECKOUT</button>
            </div>
          </div>
        </div>
      ))}
  </div>
  <!-- ...existing arrows and script code... -->
  </Container>
</div>
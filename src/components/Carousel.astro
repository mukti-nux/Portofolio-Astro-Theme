---
// Carousel.astro
import Container from './../components/Container.astro';
import { produkList } from './../data/productList';
---

<link rel="stylesheet" href="/carousel.css">

{produkList.map((kategori, index) => (
  <section class="carousel" id={`carousel-${index}`}>
    <Container>
      <h2 class="category-title">{kategori.kategori}</h2>
      <div class="list-wrapper">
        <div class="list">
          {kategori.items.map((item) => (
            kategori.tipe === 'film' ? (
              <div class="item film">
                <img src={item.gambar} alt={item.judul} />
                <div class="film-info">
                  <h3>{item.judul}</h3>
                  <p><strong>{item.nama}</strong></p>
                  <p>{item.sinopsis}</p>
                  <p><em>{item.sutradara}, {item.tahun} • {item.durasi}</em></p>
                  <a href={item.linkTrailer} target="_blank" class="seeMore">Tonton Trailer</a>
                </div>
              </div>
            ) : (
              <div class="item">
                <img src={item.gambar} alt={item.nama} />
                <div class="introduce">
                  <div class="title">{item.judul}</div>
                  <div class="topic">{item.nama}</div>
                  <div class="des">{item.deskripsiSingkat}</div>
                  <button class="seeMore">SEE MORE &#8599;</button>
                </div>
                <div class="detail">
                  <div class="title">{item.judulDetail}</div>
                  <div class="des">{item.deskripsiLengkap}</div>
                  <div class="specifications">
                    <div><p>Used Time</p><p>{item.spesifikasi.usedTime}</p></div>
                    <div><p>Charging port</p><p>{item.spesifikasi.chargingPort}</p></div>
                    <div><p>Compatible</p><p>{item.spesifikasi.compatible}</p></div>
                    <div><p>Bluetooth</p><p>{item.spesifikasi.bluetooth}</p></div>
                    <div><p>Controlled</p><p>{item.spesifikasi.control}</p></div>
                  </div>
                  <div class="checkout">
                    <button>ADD TO CART</button>
                    <button>CHECKOUT</button>
                  </div>
                </div>
              </div>
            )
          ))}
        </div>
      </div>

      <div class="arrows">
        <button class="prev">&#8249;</button>
        <button class="next">&#8250;</button>
      </div>
    </Container>
  </section>
))}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.carousel').forEach((carousel) => {
      const list = carousel.querySelector('.list');
      const nextButton = carousel.querySelector('.next');
      const prevButton = carousel.querySelector('.prev');
      const seeMoreButtons = carousel.querySelectorAll('.seeMore');
      const items = carousel.querySelectorAll('.item');
      let index = 0;

      const moveSlider = (type) => {
        index = (type === 'next')
          ? (index + 1) % items.length
          : (index - 1 + items.length) % items.length;
        list.style.transform = `translateX(-${index * 100}%)`;
      };

      nextButton?.addEventListener('click', () => moveSlider('next'));
      prevButton?.addEventListener('click', () => moveSlider('prev'));

      seeMoreButtons.forEach(button => {
        button.addEventListener('click', () => {
          carousel.classList.add('showDetail');
        });
      });

      const backButton = carousel.querySelector('.back');
      backButton?.addEventListener('click', () => {
        carousel.classList.remove('showDetail');
      });
    });
  });
</script>
